import { Button, ComboBox, HorizontalBox, VerticalBox, SpinBox, LineEdit, CheckBox, ScrollView } from "std-widgets.slint";

export struct ToolItem { id:int, label:string }
// `capture` marks the commands that stay live while a long capture runs.
export struct CommandItem { id:int, glyph:int, label:string, capture:bool }
export struct CaptureItem { id:string, label:string }
// Snapshot of everything the tool options panel can edit, sent to the editor as
// one payload so a change is applied as a whole.
export struct ToolPaint {
    tool: int,
    stroke-width: int,
    fill-opacity: int,
    font-size: int,
    block: int,
    stroke-color: color,
    fill-color: color,
    stroke-on: bool,
    fill-on: bool,
    text: string,
}
// One row of the settings page: which tool, and whether it paints an outline or
// a fill by default.
export struct ToolPaintRow { tool: int, label: string, stroke: bool, fill: bool }

// Icons are paths so the toolbar ships no image assets; the ink colour comes
// from the button that owns them.
component IconChevron inherits Path {
    in property <color> ink: #6b7280;
    width: 9px; height: 6px;
    viewbox-x: 0; viewbox-y: 0; viewbox-width: 9; viewbox-height: 6;
    commands: "M0.9 0.9 L4.5 4.5 L8.1 0.9";
    fill: transparent; stroke: root.ink; stroke-width: 1.5px;
    stroke-line-cap: round; stroke-line-join: round;
}
component IconGrip inherits Rectangle {
    in property <color> ink: #c3c8d0;
    width: 10px; height: 16px;
    background: transparent;
    for dot in [{x: 0px, y: 0px}, {x: 6px, y: 0px}, {x: 0px, y: 6px}, {x: 6px, y: 6px}, {x: 0px, y: 12px}, {x: 6px, y: 12px}]: Rectangle {
        x: dot.x; y: dot.y; width: 4px; height: 4px; border-radius: 2px; background: root.ink;
    }
}
// Shared vector grid: 24 units, 22px box, 1.75px stroke, round ends.
// All functional icons use outlines; colour is inherited from button state.
component ToolbarIcon inherits Path {
    in property <color> ink: #252a31;
    width: 22px; height: 22px;
    viewbox-x: 0; viewbox-y: 0; viewbox-width: 24; viewbox-height: 24;
    fill: transparent;
    stroke: root.ink; stroke-width: 1.75px;
    stroke-line-cap: round; stroke-line-join: round;
}
component IconSelect inherits ToolbarIcon {
    commands: "M5 3 L5 20 L9.5 15.5 L13 22 L16 20.5 L12.5 14 L19 14 Z";
}
component IconRectangle inherits ToolbarIcon {
    commands: "M5 5 H19 Q20 5 20 6 V18 Q20 19 19 19 H5 Q4 19 4 18 V6 Q4 5 5 5 Z";
}
component IconEllipse inherits ToolbarIcon {
    commands: "M20 12 A8 7 0 1 1 4 12 A8 7 0 1 1 20 12 Z";
}
component IconArrow inherits ToolbarIcon {
    commands: "M5 19 L19 5 M8 5 H19 V16";
}
component IconPen inherits ToolbarIcon {
    commands: "M15 4 L20 9 L9 20 L3 21 L4 15 Z M12 7 L17 12 M4 15 L9 20";
}
component IconMosaic inherits ToolbarIcon {
    commands: "M4 4 H10 V10 H4 Z M14 4 H20 V10 H14 Z M4 14 H10 V20 H4 Z M14 14 H20 V20 H14 Z";
}
component IconText inherits ToolbarIcon {
    commands: "M4 6 V4 H20 V6 M12 4 V20 M8 20 H16";
}
component IconUndo inherits ToolbarIcon {
    commands: "M9 4 L4 9 L9 14 M4 9 H14 C18 9 20 11 20 15 C20 18 18 20 15 20 H11";
}
component IconRedo inherits ToolbarIcon {
    commands: "M15 4 L20 9 L15 14 M20 9 H10 C6 9 4 11 4 15 C4 18 6 20 9 20 H13";
}
component IconSliders inherits ToolbarIcon {
    commands: "M4 7 H8 M12 7 H20 M4 17 H12 M16 17 H20 M8 4 H12 V10 H8 Z M12 14 H16 V20 H12 Z";
}
component IconCopy inherits ToolbarIcon {
    commands: "M9 8 H19 Q20 8 20 9 V19 Q20 20 19 20 H9 Q8 20 8 19 V9 Q8 8 9 8 Z M15 8 V5 Q15 4 14 4 H5 Q4 4 4 5 V14 Q4 15 5 15 H8";
}
component IconSave inherits ToolbarIcon {
    commands: "M12 3 V15 M7 10 L12 15 L17 10 M4 16 V20 H20 V16";
}
component IconPin inherits ToolbarIcon {
    commands: "M14 3 L21 10 L18 10 L14 14 L14 18 L6 10 L10 10 L14 6 Z M10 14 L4 20";
}
component IconClose inherits ToolbarIcon {
    commands: "M6 6 L18 18 M18 6 L6 18";
}
// Long capture: a captured band with an arrow scrolling past it. Clicking it
// starts a session on the current selection; see the editor's command 17.
component IconLongCapture inherits ToolbarIcon {
    commands: "M5 4 H19 Q20 4 20 5 V10 Q20 11 19 11 H5 Q4 11 4 10 V5 Q4 4 5 4 Z M12 14 V20 M9 17 L12 20 L15 17";
}
component ToolGlyph inherits Rectangle {
    in property <int> tool-id: 0;
    in property <color> ink: #252a31;
    width: 22px; height: 22px;
    background: transparent;
    IconSelect { visible: root.tool-id == 0; ink: root.ink; }
    IconRectangle { visible: root.tool-id == 1; ink: root.ink; }
    IconEllipse { visible: root.tool-id == 2; ink: root.ink; }
    IconArrow { visible: root.tool-id == 3; ink: root.ink; }
    IconPen { visible: root.tool-id == 4; ink: root.ink; }
    IconMosaic { visible: root.tool-id == 5; ink: root.ink; }
    IconText { visible: root.tool-id == 6; ink: root.ink; }
}
// Icon button with an optional drop-down arrow for the tool's own options.
component ToolButton inherits Rectangle {
    in property <int> tool-id: 0;
    in property <bool> selected: false;
    in property <bool> has-options: false;
    in property <bool> enabled: true;
    in property <string> label: "";
    callback activated();
    callback options-activated();
    width: root.has-options ? 50px : 40px;
    height: 40px;
    border-radius: 8px;
    background: !root.enabled ? transparent : (root.selected ? #e8f0fe : (main-hit.has-hover || arrow-hit.has-hover ? #f2f4f7 : transparent));
    ToolGlyph {
        tool-id: root.tool-id;
        ink: !root.enabled ? #c9ced5 : (root.selected ? #1668dc : #252a31);
        x: root.has-options ? 7px : 9px;
        y: 9px;
    }
    IconChevron {
        visible: root.has-options;
        ink: root.enabled ? #6b7280 : #c9ced5;
        x: root.width - 16px;
        y: 17px;
    }
    main-hit := TouchArea {
        enabled: root.enabled;
        width: root.has-options ? root.width - 19px : root.width;
        height: root.height;
        accessible-role: button;
        accessible-label: root.label;
        clicked => { root.activated(); }
    }
    arrow-hit := TouchArea {
        enabled: root.enabled;
        x: root.has-options ? root.width - 19px : root.width;
        width: root.has-options ? 19px : 0px;
        height: root.height;
        accessible-role: button;
        accessible-label: root.label + " options";
        clicked => { root.options-activated(); }
    }
}
// History and command icons, selected by number.
component CommandGlyph inherits Rectangle {
    in property <int> glyph: 0;
    in property <color> ink: #252a31;
    width: 22px; height: 22px;
    background: transparent;
    IconUndo { visible: root.glyph == 0; ink: root.ink; }
    IconRedo { visible: root.glyph == 1; ink: root.ink; }
    IconSliders { visible: root.glyph == 2; ink: root.ink; }
    IconCopy { visible: root.glyph == 3; ink: root.ink; }
    IconSave { visible: root.glyph == 4; ink: root.ink; }
    IconPin { visible: root.glyph == 5; ink: root.ink; }
    IconClose { visible: root.glyph == 6; ink: root.ink; }
    IconLongCapture { visible: root.glyph == 7; ink: root.ink; }
}
// Plain icon button used for history and the command group.
component BarButton inherits Rectangle {
    in property <int> glyph: 0;
    in property <bool> enabled: true;
    in property <bool> highlighted: false;
    in property <string> label: "";
    callback activated();
    width: 40px; height: 40px;
    border-radius: 8px;
    background: !root.enabled ? transparent : (root.highlighted ? #e8f0fe : (hit.has-hover ? #f2f4f7 : transparent));
    CommandGlyph {
        glyph: root.glyph;
        ink: root.enabled ? #252a31 : #c9ced5;
        x: 9px; y: 9px;
    }
    hit := TouchArea {
        enabled: root.enabled;
        accessible-role: button;
        accessible-label: root.label;
        clicked => { root.activated(); }
    }
}
component Divider inherits Rectangle {
    width: 13px; height: 40px;
    background: transparent;
    Rectangle { x: 6px; y: 8px; width: 1px; height: 24px; background: #e4e7ec; }
}
// Colour swatch that opens the picker. The size stays a parameter so the
// presets in the picker can shrink it below the options-bar default.
component ColorButton inherits Rectangle {
    in property <color> swatch: #ffffff;
    in property <string> label: "";
    in property <length> size: 26px;
    callback picked();
    width: root.size; height: root.size;
    border-radius: 6px;
    background: root.swatch;
    border-width: 1px;
    border-color: #d3d7dd;
    TouchArea {
        accessible-role: button;
        accessible-label: root.label;
        clicked => { root.picked(); }
    }
}
// Outline/fill switch. Its state is a read-only binding (`on`) driven by the
// model, so it stays correct inside a `for` loop; a std-widgets CheckBox keeps
// its own writable `checked` binding and would drift from the model.
component PaintToggle inherits Rectangle {
    in property <string> label: "";
    in property <bool> on: false;
    callback toggled();
    width: 56px; height: 24px;
    border-radius: 12px;
    background: root.on ? #e8f0fe : #f2f4f7;
    border-width: 1px;
    border-color: root.on ? #3388ff : #d3d7dd;
    Text {
        width: 100%; height: 100%;
        text: root.label;
        font-size: 12px;
        color: root.on ? #1668dc : #4b5563;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea {
        accessible-role: checkbox;
        accessible-label: root.label;
        accessible-checked: root.on;
        clicked => { root.toggled(); }
    }
}
// Shared paint controls: the tool options panel and the persistent paint bar
// show the same values, so the row lives here once.
component PaintControls inherits Rectangle {
    in-out property <int> tool: 1;
    in-out property <int> stroke-width: 3;
    in-out property <int> block: 12;
    in-out property <string> text-value: "";
    in-out property <int> fill-opacity: 100;
    in-out property <int> font-size: 32;
    in-out property <color> stroke-color: #f23340;
    in-out property <color> fill-color: #f23340;
    in-out property <bool> stroke-on: true;
    in-out property <bool> fill-on: false;
    // Aggregates the editable values so every change sends one consistent
    // snapshot instead of a hand-built argument list.
    out property <ToolPaint> paint: {
        tool: root.tool,
        stroke-width: root.stroke-width,
        fill-opacity: root.fill-opacity,
        font-size: root.font-size,
        block: root.block,
        stroke-color: root.stroke-color,
        fill-color: root.fill-color,
        stroke-on: root.stroke-on,
        fill-on: root.fill-on,
        text: root.text-value,
    };
    callback changed(ToolPaint);
    // 0 asks for the outline colour, 1 for the fill colour.
    callback pick(int);
    background: transparent;
    HorizontalLayout {
        // Conditional elements rather than `visible: false`: a hidden element
        // still occupies its slot in a layout, which pushed the colours and the
        // close button out of the panel.
        padding: 0px; spacing: 10px; alignment: start;
        // Outline group: shape tools, the pen and text.
        if root.tool == 1 || root.tool == 2 || root.tool == 3 || root.tool == 4 || root.tool == 6: PaintToggle {
            label: "描边"; on: root.stroke-on;
            toggled => { root.stroke-on = !root.stroke-on; root.changed(root.paint); }
        }
        if root.tool == 1 || root.tool == 2 || root.tool == 3 || root.tool == 4 || root.tool == 6: ColorButton {
            swatch: root.stroke-color; label: "描边色";
            picked => { root.pick(0); }
        }
        if root.tool == 1 || root.tool == 2 || root.tool == 3 || root.tool == 4 || root.tool == 6: SpinBox {
            accessible-label: "描边宽度";
            // Wide enough for two digits plus the arrow column, which is drawn
            // outside the box when the value needs more room than it has.
            width: 92px;
            minimum: 1; maximum: 64; value <=> root.stroke-width;
            edited => { root.changed(root.paint); }
        }
        // Fill group: rectangles, ellipses and text.
        if root.tool == 1 || root.tool == 2 || root.tool == 6: PaintToggle {
            label: "填充"; on: root.fill-on;
            toggled => { root.fill-on = !root.fill-on; root.changed(root.paint); }
        }
        if root.tool == 1 || root.tool == 2 || root.tool == 6: ColorButton {
            swatch: root.fill-color; label: "填充色";
            picked => { root.pick(1); }
        }
        if root.tool == 1 || root.tool == 2 || root.tool == 6: SpinBox {
            accessible-label: "填充不透明度";
            width: 92px;
            minimum: 0; maximum: 100; value <=> root.fill-opacity;
            edited => { root.changed(root.paint); }
        }
        if root.tool == 6: Text { text: "字号"; color: #4b5563; font-size: 13px; vertical-alignment: center; }
        if root.tool == 6: SpinBox {
            accessible-label: "字号";
            width: 72px;
            minimum: 12; maximum: 200; value <=> root.font-size;
            edited => { root.changed(root.paint); }
        }
        if root.tool == 6: LineEdit {
            accessible-label: "标注文字";
            text <=> root.text-value;
            placeholder-text: "文字";
            horizontal-stretch: 1;
            edited => { root.changed(root.paint); }
        }
        if root.tool == 5: Text { text: "马赛克块"; color: #4b5563; font-size: 13px; vertical-alignment: center; }
        if root.tool == 5: SpinBox {
            accessible-label: "马赛克块";
            width: 96px;
            minimum: 2; maximum: 128; value <=> root.block;
            edited => { root.changed(root.paint); }
        }
    }
}

export component Toolbar inherits Window {
    title: "Snaplight Tools";
    no-frame: true;
    always-on-top: true;
    in property <length> bar-width: 758px;
    width: root.bar-width;
    height: 52px;
    in-out property <bool> repaint: false;
    background: root.repaint ? #ffffff : #fefefe;
    default-font-family: "Segoe UI";
    in property <[ToolItem]> tools;
    in property <[CommandItem]> actions;
    // True while a long capture runs: the drawing tools, the history and the tool
    // options step aside, only the action buttons marked `capture` stay live, and
    // the pill stops being draggable so it cannot be moved over the region.
    in-out property <bool> long-capture: false;
    in-out property <int> active: 0;
    in-out property <int> stroke-width: 3;
    in-out property <int> block: 12;
    in-out property <string> text-value: "";
    in-out property <int> fill-opacity: 100;
    in-out property <int> font-size: 32;
    in-out property <color> stroke-color: #f23340;
    in-out property <color> fill-color: #f23340;
    // One entry per stable tool id (0..6), so the editor can map a tool to its
    // default paint without a second lookup table.
    in-out property <[bool]> stroke-tools: [false, true, true, true, true, false, false];
    in-out property <[bool]> fill-tools: [false, false, false, false, false, false, true];
    in-out property <string> status: "";
    in-out property <bool> can-undo: false;
    in-out property <bool> can-redo: false;
    callback command(int);
    callback options-toggled(int);
    Rectangle {
        width: 100%; height: 100%;
        background: root.background;
        border-radius: 10px;
        border-width: 1px;
        border-color: #e8eaee;
        clip: true;
        HorizontalLayout {
            padding-left: 10px; padding-right: 10px; padding-top: 6px; padding-bottom: 6px; spacing: 2px;
            WindowMoveArea {
                enabled: !root.long-capture;
                width: 18px; height: 40px;
                IconGrip { x: 4px; y: 12px; }
            }
            for tool in root.tools: ToolButton {
                tool-id: tool.id;
                label: tool.label;
                selected: root.active == tool.id;
                has-options: tool.id != 0;
                enabled: !root.long-capture;
                activated => { root.active = tool.id; root.command(tool.id); }
                options-activated => { root.options-toggled(tool.id); }
            }
            Divider { }
            BarButton {
                glyph: 0; label: "撤销"; enabled: root.can-undo && !root.long-capture;
                activated => { root.command(10); }
            }
            BarButton {
                glyph: 1; label: "重做"; enabled: root.can-redo && !root.long-capture;
                activated => { root.command(11); }
            }
            Divider { }
            for action in root.actions: BarButton {
                glyph: action.glyph; label: action.label;
                enabled: !root.long-capture || action.capture;
                activated => {
                    if action.id == 16 { root.options-toggled(root.active); }
                    else { root.command(action.id); }
                }
            }
        }
    }
}

// Quick settings for the tool whose drop-down was clicked; the same values are
// editable in the settings window.
export component OptionsPanel inherits Window {
    title: "Snaplight Tool Options";
    no-frame: true;
    always-on-top: true;
    // The row is only as wide as the active tool needs, so a tool that paints
    // fewer values gets a shorter panel instead of a wide one with empty space.
    // `snaplight_ui::paint_logical_size` supplies the width and must agree.
    in property <length> row-width: 460px;
    width: root.row-width;
    height: 52px;
    background: #ffffff;
    default-font-family: "Segoe UI";
    in-out property <int> tool: 1;
    in-out property <int> stroke-width: 3;
    in-out property <int> block: 12;
    in-out property <string> text-value: "";
    in-out property <int> fill-opacity: 100;
    in-out property <int> font-size: 32;
    in-out property <color> stroke-color: #f23340;
    in-out property <color> fill-color: #f23340;
    in-out property <bool> stroke-on: true;
    in-out property <bool> fill-on: false;
    callback properties-changed(ToolPaint);
    // 0 asks for the outline colour, 1 for the fill colour.
    callback pick-color(int);
    callback dismissed();
    // Aggregates the editable values so every change sends one consistent
    // snapshot instead of a hand-built argument list.
    out property <ToolPaint> paint: {
        tool: root.tool,
        stroke-width: root.stroke-width,
        fill-opacity: root.fill-opacity,
        font-size: root.font-size,
        block: root.block,
        stroke-color: root.stroke-color,
        fill-color: root.fill-color,
        stroke-on: root.stroke-on,
        fill-on: root.fill-on,
        text: root.text-value,
    };
    Rectangle {
        width: 100%; height: 100%;
        background: #ffffff;
        border-radius: self.height / 2;
        border-width: 1px;
        border-color: #e8eaee;
        clip: true;
        HorizontalLayout {
            padding-left: 14px; padding-right: 8px; spacing: 10px;
            // The panel is as wide as the longest tool needs, so a shorter tool
            // is centred between the spacer and the close button instead of
            // leaving its gap on one side.
            Rectangle { horizontal-stretch: 1; }
            ctl := PaintControls {
                tool <=> root.tool;
                stroke-width <=> root.stroke-width;
                block <=> root.block;
                text-value <=> root.text-value;
                fill-opacity <=> root.fill-opacity;
                font-size <=> root.font-size;
                stroke-color <=> root.stroke-color;
                fill-color <=> root.fill-color;
                stroke-on <=> root.stroke-on;
                fill-on <=> root.fill-on;
                changed(paint) => { root.properties-changed(paint); }
                pick(target) => { root.pick-color(target); }
            }
            Rectangle { horizontal-stretch: 1; }
            BarButton {
                glyph: 6; label: "关闭选项";
                activated => { root.dismissed(); }
            }
        }
    }
}

// Persistent paint bar at the bottom of the editor. It carries the same paint
// controls as the tool options panel but has no close button. PAINT_BAR_TITLE
// in lib.rs must match, and its width comes from `paint_logical_size` so the bar
// never shows a row of empty space.
export component PaintBar inherits Window {
    title: "Snaplight Paint";
    no-frame: true;
    always-on-top: true;
    in property <length> row-width: 460px;
    width: root.row-width;
    height: 52px;
    background: #ffffff;
    default-font-family: "Segoe UI";
    in-out property <int> tool: 1;
    in-out property <int> stroke-width: 3;
    in-out property <int> block: 12;
    in-out property <string> text-value: "";
    in-out property <int> fill-opacity: 100;
    in-out property <int> font-size: 32;
    in-out property <color> stroke-color: #f23340;
    in-out property <color> fill-color: #f23340;
    in-out property <bool> stroke-on: true;
    in-out property <bool> fill-on: false;
    // Same aggregate as the options panel, so the editor can treat both windows
    // the same way.
    out property <ToolPaint> paint: {
        tool: root.tool,
        stroke-width: root.stroke-width,
        fill-opacity: root.fill-opacity,
        font-size: root.font-size,
        block: root.block,
        stroke-color: root.stroke-color,
        fill-color: root.fill-color,
        stroke-on: root.stroke-on,
        fill-on: root.fill-on,
        text: root.text-value,
    };
    callback properties-changed(ToolPaint);
    // 0 asks for the outline colour, 1 for the fill colour.
    callback pick-color(int);
    Rectangle {
        width: 100%; height: 100%;
        background: #ffffff;
        border-radius: self.height / 2;
        border-width: 1px;
        border-color: #e8eaee;
        clip: true;
        HorizontalLayout {
            padding-left: 14px; padding-right: 14px; spacing: 10px;
            ctl := PaintControls {
                tool <=> root.tool;
                stroke-width <=> root.stroke-width;
                block <=> root.block;
                text-value <=> root.text-value;
                fill-opacity <=> root.fill-opacity;
                font-size <=> root.font-size;
                stroke-color <=> root.stroke-color;
                fill-color <=> root.fill-color;
                stroke-on <=> root.stroke-on;
                fill-on <=> root.fill-on;
                horizontal-stretch: 1;
                changed(paint) => { root.properties-changed(paint); }
                pick(target) => { root.pick-color(target); }
            }
        }
    }
}

// Colour picker. All colour arithmetic (hex parsing, HSV conversion, the hue
// base) lives in Rust; this window only reports pointer positions and text and
// renders what Rust writes back. PICKER_LOGICAL_SIZE and PICKER_TITLE in
// lib.rs must match the size and title below.
export component ColorPicker inherits Window {
    title: "Snaplight Color";
    no-frame: true;
    always-on-top: true;
    width: 280px;
    height: 256px;
    default-font-family: "Segoe UI";
    in property <string> target-label: "描边色";
    // Fully saturated, fully bright colour of the current hue.
    in property <color> sv-base: #ff0000;
    in property <color> color-value: #f23340;
    in-out property <float> hue: 0.0;
    in-out property <float> saturation: 1.0;
    // Named brightness rather than value to avoid clashing with the `value`
    // used by widgets.
    in-out property <float> brightness: 0.95;
    in-out property <string> hex-text: "#F23340";
    callback hue-picked(float);
    callback sv-picked(float, float);
    callback hex-edited(string);
    callback preset-picked(color);
    callback dismissed();
    Rectangle {
        width: 100%; height: 100%;
        background: #ffffff;
        border-radius: 12px;
        border-width: 1px;
        border-color: #e8eaee;
        clip: true;
        Text {
            x: 16px; y: 8px; width: 248px; height: 18px;
            text: "拾色器 · " + root.target-label;
            font-size: 13px; color: #111827;
            vertical-alignment: center;
        }
        // Standard HSV square: hue underneath, white towards the right, black
        // towards the bottom.
        Rectangle {
            x: 16px; y: 32px; width: 248px; height: 128px;
            border-radius: 4px; clip: true;
            Rectangle { background: root.sv-base; }
            Rectangle { background: @linear-gradient(90deg, white 0%, transparent 100%); }
            Rectangle { background: @linear-gradient(180deg, transparent 0%, black 100%); }
        }
        sv := TouchArea {
            x: 16px; y: 32px; width: 248px; height: 128px;
            accessible-role: button;
            accessible-label: "饱和度和明度";
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.sv-picked(clamp(self.mouse-x / self.width, 0, 1), clamp(1 - self.mouse-y / self.height, 0, 1));
                }
            }
            moved => {
                if self.pressed {
                    root.sv-picked(clamp(self.mouse-x / self.width, 0, 1), clamp(1 - self.mouse-y / self.height, 0, 1));
                }
            }
        }
        Rectangle {
            x: 16px; y: 168px; width: 248px; height: 14px;
            border-radius: 7px; clip: true;
            background: @linear-gradient(90deg, #ff0000 0%, #ffff00 17%, #00ff00 33%, #00ffff 50%, #0000ff 67%, #ff00ff 83%, #ff0000 100%);
        }
        hue-bar := TouchArea {
            x: 16px; y: 168px; width: 248px; height: 14px;
            accessible-role: button;
            accessible-label: "色相";
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.hue-picked(clamp(self.mouse-x / self.width, 0, 1));
                }
            }
            moved => {
                if self.pressed { root.hue-picked(clamp(self.mouse-x / self.width, 0, 1)); }
            }
        }
        HorizontalLayout {
            x: 16px; y: 190px; width: 248px; height: 30px;
            spacing: 8px; alignment: center;
            Text { text: "十六进制"; color: #4b5563; font-size: 13px; vertical-alignment: center; }
            LineEdit {
                accessible-label: "十六进制颜色";
                text <=> root.hex-text;
                horizontal-stretch: 1;
                edited => { root.hex-edited(root.hex-text); }
            }
            // Preview only; clicking it has no effect.
            ColorButton { swatch: root.color-value; label: "当前颜色"; picked => { } }
            Button {
                text: "完成"; accessible-label: "完成取色";
                clicked => { root.dismissed(); }
            }
        }
        HorizontalLayout {
            x: 16px; y: 224px; width: 248px; height: 22px;
            spacing: 10px; alignment: center;
            for preset[index] in [#f23340, #ff8c1a, #ffc94a, #35c9a0, #3388ff, #a855f7, #ffffff, #202124]: ColorButton {
                size: 22px;
                swatch: preset;
                label: "预设颜色 " + (index + 1);
                picked => { root.preset-picked(preset); }
            }
        }
    }
}

// Settings navigation entry; the pane on the right follows the selection.
component NavButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> selected: false;
    callback activated();
    height: 38px;
    border-radius: 6px;
    background: root.selected ? #e8f0fe : (hit.has-hover ? #eceff3 : transparent);
    Rectangle {
        visible: root.selected;
        x: 0px; y: 9px; width: 3px; height: root.height - 18px;
        border-radius: 1.5px;
        background: #1668dc;
    }
    Text {
        x: 14px; y: 0px; width: root.width - 22px; height: 100%;
        text: root.label;
        color: root.selected ? #1668dc : #252a31;
        font-weight: root.selected ? 600 : 400;
        vertical-alignment: center;
        overflow: elide;
    }
    hit := TouchArea {
        accessible-role: button;
        accessible-label: root.label;
        clicked => { root.activated(); }
    }
}
component SectionTitle inherits Text {
    in property <bool> changed: false;
    color: #111827; font-weight: root.changed ? 700 : 600; font-size: 13px;
}
component Hint inherits Text {
    color: #6b7280; font-size: 12px; wrap: word-wrap;
}
component Rule inherits Rectangle {
    height: 1px; background: #eef0f3;
}
// Compact symbol button for the shortcut recorder: a green check accepts the
// draft and a red cross drops it. The symbols are vector paths, so they do not
// depend on the glyph coverage of the UI font. A standard Button takes
// keyboard focus on press, which would abort the recording before its click
// lands, so the recorder uses a touch area instead.
component GlyphButton inherits Rectangle {
    // Path commands for the symbol, in a 24x24 view box.
    in property <string> commands: "";
    in property <color> ink: #16a34a;
    in property <string> label: "";
    in property <bool> enabled: true;
    callback clicked();
    width: 28px;
    height: 28px;
    border-radius: 6px;
    background: !root.enabled ? transparent : (hit.has-hover ? #eef1f5 : transparent);
    Path {
        x: 6px; y: 6px;
        width: 16px; height: 16px;
        viewbox-x: 0; viewbox-y: 0;
        viewbox-width: 24; viewbox-height: 24;
        commands: root.commands;
        fill: transparent;
        stroke: root.enabled ? root.ink : #c3c8d0;
        stroke-width: 2px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
    hit := TouchArea {
        enabled: root.enabled;
        accessible-role: button;
        accessible-label: root.label;
        clicked => { root.clicked(); }
        accessible-action-default => { root.clicked(); }
    }
}
// One shortcut row. The current combination sits on the right as a command
// chip; clicking it starts recording the next key combination, and the check
// and cross actions appear next to it. The recording lives in this component,
// while `active-slot` in the window keeps at most one recorder open. The
// combination text itself is built in Rust, so the recorder and the
// configuration parser accept exactly the same keys.
component HotkeyRow inherits HorizontalBox {
    spacing: 8px;
    in property <string> label: "";
    in property <int> slot: 0;
    in property <bool> allow-modifier-only: false;
    // Set by the page when this row differs from the value it opened with.
    in property <bool> changed: false;
    // Raised after the check commits a captured combination.
    callback edited();
    in-out property <string> value: "";
    in-out property <int> active-slot: 0;
    callback captured-hotkey(string, bool, bool, bool, bool, bool) -> string;
    // Accepted combination of the current recording. It stays empty until a key
    // the configuration can store is pressed, which keeps Save disabled.
    in-out property <string> draft: "";
    in-out property <bool> recording: false;
    out property <bool> is-open: root.active-slot == root.slot && (root.recording || root.draft != "");
    pure function is-modifier-key(text: string) -> bool {
        return text == Key.Shift || text == Key.ShiftR
            || text == Key.Control || text == Key.ControlR
            || text == Key.Alt || text == Key.AltGr
            || text == Key.Meta || text == Key.MetaR;
    }
    function start-recording() {
        root.active-slot = root.slot;
        root.draft = "";
        root.recording = true;
        fs.focus();
    }
    function accept-draft() {
        // Nothing accepted yet: the check is disabled, so Enter and an
        // accidental activation leave the recording open.
        if (root.draft == "") {
            return;
        }
        root.value = root.draft;
        root.draft = "";
        root.recording = false;
        root.active-slot = 0;
        root.edited();
    }
    function cancel-draft() {
        root.recording = false;
        root.draft = "";
        root.active-slot = 0;
    }
    Text {
        text: root.label;
        vertical-alignment: center;
        horizontal-stretch: 1;
        font-weight: root.changed ? 700 : 400;
    }
    // The actions sit before the chip so showing them only takes width from
    // the flexible label; the chip stays anchored to the right edge while
    // recording starts and stops.
    if root.is-open: GlyphButton {
        commands: "M5 12 L10 17 L19 7";
        ink: #16a34a;
        label: "保存快捷键";
        enabled: root.draft != "";
        clicked => { root.accept-draft(); }
    }
    if root.is-open: GlyphButton {
        commands: "M7 7 L17 17 M17 7 L7 17";
        ink: #dc2626;
        label: "取消录制";
        clicked => { root.cancel-draft(); }
    }
    chip := Rectangle {
        width: 172px;
        height: 28px;
        border-radius: 6px;
        background: root.is-open ? #f0f6ff : #f7f8fa;
        border-width: 1px;
        border-color: root.is-open ? #1668dc : (chip-hit.has-hover ? #98a2b3 : #d0d5dd);
        Text {
            x: 8px;
            width: parent.width - 16px;
            height: 100%;
            // While no accepted key has been captured, the chip prompts instead
            // of showing the old combination.
            text: root.recording
                ? (root.draft == "" ? "请按下快捷键…" : root.draft)
                : (root.draft != "" ? root.draft : root.value);
            color: root.recording && root.draft == "" ? #6b7280 : #111827;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
        fs := FocusScope {
            key-pressed(event) => {
                if (!root.is-open) {
                    return reject;
                }
                if (event.text == Key.Escape) {
                    root.cancel-draft();
                    return accept;
                }
                if (event.text == Key.Return) {
                    root.accept-draft();
                    return accept;
                }
                // While a captured draft is pending, swallow keys so the page
                // does not react behind the recorder; repeats never overwrite it.
                if (!root.recording || event.repeat) {
                    return accept;
                }
                let captured = root.captured-hotkey(
                    event.text,
                    event.modifiers.control,
                    event.modifiers.shift,
                    event.modifiers.alt,
                    event.modifiers.meta,
                    root.allow-modifier-only
                );
                if (captured != "") {
                    root.draft = captured;
                    // A lone modifier only builds the combination: the user may
                    // add more before pressing Save. A regular key completes it.
                    if (!root.is-modifier-key(event.text)) {
                        root.recording = false;
                    }
                }
                return accept;
            }
            // Clicking a focusable widget elsewhere ends the recording. Save and
            // Cancel do not take focus, so their clicks still land; a captured
            // draft survives until the user decides.
            focus-lost(reason) => {
                if (root.is-open && root.recording) {
                    root.recording = false;
                    root.draft = "";
                    root.active-slot = 0;
                }
            }
        }
        chip-hit := TouchArea {
            enabled: !root.recording || !root.is-open;
            accessible-role: button;
            accessible-label: root.label + "快捷键，当前 " + root.value;
            clicked => { root.start-recording(); }
            accessible-action-default => { root.start-recording(); }
        }
    }
}

export component Settings inherits Window {
    // Keep in sync with SETTINGS_TITLE in lib.rs, which the editor uses to find
    // this window for the app icon.
    title: "Snaplight 设置";
    width: 900px;
    height: 640px;
    default-font-family: "Segoe UI";
    in-out property <[ToolItem]> tools;
    in-out property <[CaptureItem]> captures;
    in-out property <string> pending-delete:"";
    in-out property <bool> gpu-pins:false;
    in-out property <bool> pin-close-confirm:true;
    in-out property <bool> pin-shadow:true;
    in-out property <int> pin-shadow-blur:8;
    in-out property <int> pin-shadow-offset:2;
    in-out property <int> pin-shadow-opacity:20;
    in-out property <int> stroke:3;
    in-out property <int> block:12;
    in-out property <int> fill-opacity:100;
    in-out property <int> font-size:32;
    in-out property <string> stroke-color-value:"#F23340";
    in-out property <string> fill-color-value:"#F23340";
    in-out property <[ToolPaintRow]> paint-tools;
    in-out property <string> background-value:"#202124";
    in-out property <string> foreground-value:"#f4f5f6";
    in-out property <string> accent-value:"#36c9a0";
    in-out property <string> capture-dir-value:"";
    in-out property <string> capture-hotkey-value:"Ctrl+Shift+A";
    in-out property <string> restore-hotkey-value:"Ctrl+Shift+P";
    in-out property <string> through-hotkey-value:"Ctrl";
    // Shortcut row that is currently recording: 0 none, 1 capture, 2 restore,
    // 3 held interaction key. At most one recorder is open at a time.
    in-out property <int> hotkey-editing:0;
    in-out property <int> detect-mode:1;
    in-out property <string> status:"";
    // Bold markers for values that differ from the configuration this window
    // opened with. The editor recomputes every marker after each auto-save.
    in-out property <bool> changed-gpu-pins:false;
    in-out property <bool> changed-pin-close-confirm:false;
    in-out property <bool> changed-tool-order:false;
    in-out property <bool> changed-background:false;
    in-out property <bool> changed-foreground:false;
    in-out property <bool> changed-accent:false;
    in-out property <bool> changed-pin-shadow:false;
    in-out property <bool> changed-shadow-blur:false;
    in-out property <bool> changed-shadow-offset:false;
    in-out property <bool> changed-shadow-opacity:false;
    in-out property <bool> changed-capture-hotkey:false;
    in-out property <bool> changed-restore-hotkey:false;
    in-out property <bool> changed-through-hotkey:false;
    in-out property <bool> changed-stroke:false;
    in-out property <bool> changed-block:false;
    in-out property <bool> changed-stroke-color:false;
    in-out property <bool> changed-fill-color:false;
    in-out property <bool> changed-fill-opacity:false;
    in-out property <bool> changed-font-size:false;
    in-out property <bool> changed-paint-tools:false;
    in-out property <bool> changed-detect-mode:false;
    in-out property <bool> changed-capture-dir:false;
    // Every user edit restarts this short timer; the window then saves once
    // instead of writing the configuration on each keystroke or spinner step.
    // `running` has to be set too: a Slint Timer that never ran ignores
    // `restart()`, so the first edit must start it before restarting.
    function mark-changed() {
        auto-save.running = true;
        auto-save.restart();
    }
    auto-save := Timer {
        interval: 500ms;
        running: false;
        triggered => {
            auto-save.running = false;
            root.save();
        }
    }
    in property <string> app-version:"";
    in property <string> config-path:"";
    in property <string> data-dir:"";
    // Navigation index: 0 General, 1 Appearance, 2 Hotkeys, 3 Capture,
    // 4 Translation, 5 Screen recording, 6 Settings. The navigation model and
    // the page conditions below must stay in the same order.
    in-out property <int> page: 0;
    out property <int> page-index: root.page < 0 ? 0 : (root.page > 6 ? 6 : root.page);
    out property <string> page-title: ["常规","外观","快捷键","截图","翻译","屏幕录制","设置"][root.page-index];
    callback save();
    callback move-tool(int,int);
    callback browse-capture-dir();
    callback open-capture-folder();
    callback open-capture(string);
    callback delete-capture(string);
    callback open-data-dir();
    // Formats one captured key and its modifiers as a stored shortcut; an empty
    // result means the key cannot be stored and the recorder keeps waiting.
    callback captured-hotkey(string, bool, bool, bool, bool, bool) -> string;
    // Tool id, paint slot (0 stroke / 1 fill) and the requested state.
    callback paint-toggled(int, int, bool);
    VerticalBox {padding:0px; spacing:0px;
        HorizontalBox {vertical-stretch:1; spacing:0px;
            // Function navigation.
            Rectangle {
                width:208px; vertical-stretch:1;
                background:#f7f8fa;
                VerticalLayout {padding:12px; spacing:4px;
                    Text {text:"Snaplight";font-size:15px;font-weight:600;color:#111827;}
                    Text {text:"设置";font-size:12px;color:#6b7280;}
                    Rectangle {height:10px;}
                    NavButton {label:"常规";selected:root.page-index==0;activated=>{root.page=0;}}
                    NavButton {label:"外观";selected:root.page-index==1;activated=>{root.page=1;}}
                    NavButton {label:"快捷键";selected:root.page-index==2;activated=>{root.page=2;}}
                    NavButton {label:"截图";selected:root.page-index==3;activated=>{root.page=3;}}
                    NavButton {label:"翻译";selected:root.page-index==4;activated=>{root.page=4;}}
                    NavButton {label:"屏幕录制";selected:root.page-index==5;activated=>{root.page=5;}}
                    NavButton {label:"设置";selected:root.page-index==6;activated=>{root.page=6;}}
                    Rectangle {vertical-stretch:1;}
                }
            }
            Rectangle {width:1px;vertical-stretch:1;background:#e4e7ec;}
            // Options for the selected navigation entry.
            Rectangle {
                horizontal-stretch:1; vertical-stretch:1;
                background:#ffffff;
                VerticalLayout {padding:16px; spacing:10px;
                    Text {text:root.page-title;font-size:16px;font-weight:600;color:#111827;}
                    ScrollView {vertical-stretch:1;
                        VerticalLayout {alignment:start; spacing:10px;
                            if root.page-index == 0: VerticalLayout {alignment:start; spacing:8px;
                                SectionTitle {text:"贴图";}
                                CheckBox {text:"GPU 贴图";font-weight:root.changed-gpu-pins ? 700 : 400;checked<=>root.gpu-pins;toggled=>{root.mark-changed();}}
                                Hint {text:"用常驻 DirectComposition 表面渲染贴图，仅对新贴图生效；默认的 layered 后端私有内存更低。";}
                                CheckBox {text:"关闭贴图前确认";font-weight:root.changed-pin-close-confirm ? 700 : 400;checked<=>root.pin-close-confirm;toggled=>{root.mark-changed();}}
                                Hint {text:"双击贴图关闭它之前先弹出确认窗口；在窗口里勾选「下次不再提醒」会把这里改成关闭。";}
                                Rule {}
                                SectionTitle {text:"工具栏";changed:root.changed-tool-order;}
                                Hint {text:"标注工具，按悬浮条上显示的顺序排列。";}
                                for tool[index] in root.tools: HorizontalBox {
                                    Text {text:tool.label;vertical-alignment:center;horizontal-stretch:1;}
                                    Button {text:"上移";accessible-label:tool.label + " 上移";clicked=>{root.move-tool(index,-1);root.mark-changed();}}
                                    Button {text:"下移";accessible-label:tool.label + " 下移";clicked=>{root.move-tool(index,1);root.mark-changed();}}
                                }
                            }
                            if root.page-index == 1: VerticalLayout {alignment:start; spacing:8px;
                                HorizontalBox {Text {text:"背景色";font-weight:root.changed-background ? 700 : 400;vertical-alignment:center;horizontal-stretch:1;} LineEdit {accessible-label:"主题背景色";text<=>root.background-value;edited=>{root.mark-changed();}}}
                                HorizontalBox {Text {text:"前景色";font-weight:root.changed-foreground ? 700 : 400;vertical-alignment:center;horizontal-stretch:1;} LineEdit {accessible-label:"主题前景色";text<=>root.foreground-value;edited=>{root.mark-changed();}}}
                                HorizontalBox {Text {text:"强调色";font-weight:root.changed-accent ? 700 : 400;vertical-alignment:center;horizontal-stretch:1;} LineEdit {accessible-label:"主题强调色";text<=>root.accent-value;edited=>{root.mark-changed();}}}
                                Hint {text:"截图界面的选区、工具栏与贴图的配色；输入的十六进制颜色会自动保存并生效。";}
                                Rule {}
                                SectionTitle {text:"贴图阴影";}
                                CheckBox {text:"贴图默认带阴影";font-weight:root.changed-pin-shadow ? 700 : 400;checked<=>root.pin-shadow;toggled=>{root.mark-changed();}}
                                HorizontalBox {Text {text:"模糊";font-weight:root.changed-shadow-blur ? 700 : 400;vertical-alignment:center;horizontal-stretch:1;} SpinBox {accessible-label:"阴影模糊";minimum:0;maximum:48;value<=>root.pin-shadow-blur;edited=>{root.mark-changed();}}}
                                HorizontalBox {Text {text:"垂直偏移";font-weight:root.changed-shadow-offset ? 700 : 400;vertical-alignment:center;horizontal-stretch:1;} SpinBox {accessible-label:"阴影垂直偏移";minimum:0;maximum:24;value<=>root.pin-shadow-offset;edited=>{root.mark-changed();}}}
                                HorizontalBox {Text {text:"不透明度";font-weight:root.changed-shadow-opacity ? 700 : 400;vertical-alignment:center;horizontal-stretch:1;} SpinBox {accessible-label:"阴影不透明度";minimum:0;maximum:100;value<=>root.pin-shadow-opacity;edited=>{root.mark-changed();}}}
                                Hint {text:"贴图贴在桌面上时在四周投下阴影，看起来是浮起来的。模糊和垂直偏移是 100% 缩放下的逻辑像素，不透明度是贴图边缘处的浓度；修改会自动保存并立即生效，对已打开的贴图同样有效。右键某一张贴图可以单独关闭它的阴影。";}
                            }
                            if root.page-index == 2: VerticalLayout {alignment:start; spacing:8px;
                                SectionTitle {text:"全局快捷键";}
                                HotkeyRow {
                                    label:"截图";slot:1;allow-modifier-only:false;
                                    changed:root.changed-capture-hotkey;
                                    value<=>root.capture-hotkey-value;
                                    active-slot<=>root.hotkey-editing;
                                    edited => { root.mark-changed(); }
                                    captured-hotkey(key,ctrl,shift,alt,win,allow-modifier-only) => {
                                        return root.captured-hotkey(key,ctrl,shift,alt,win,allow-modifier-only);
                                    }
                                }
                                HotkeyRow {
                                    label:"恢复贴图";slot:2;allow-modifier-only:false;
                                    changed:root.changed-restore-hotkey;
                                    value<=>root.restore-hotkey-value;
                                    active-slot<=>root.hotkey-editing;
                                    edited => { root.mark-changed(); }
                                    captured-hotkey(key,ctrl,shift,alt,win,allow-modifier-only) => {
                                        return root.captured-hotkey(key,ctrl,shift,alt,win,allow-modifier-only);
                                    }
                                }
                                Hint {text:"单击右侧的快捷键开始录制，按下组合键后点绿色勾确认；按 Esc 或红色叉放弃本次录制。支持字母、数字和 F1–F24，并且至少要有一个修饰键。确认后自动保存并立即生效；若快捷键已被占用，则回退到默认值。";}
                                Rule {}
                                SectionTitle {text:"贴图穿透";}
                                HotkeyRow {
                                    label:"临时交互按键";slot:3;allow-modifier-only:true;
                                    changed:root.changed-through-hotkey;
                                    value<=>root.through-hotkey-value;
                                    active-slot<=>root.hotkey-editing;
                                    edited => { root.mark-changed(); }
                                    captured-hotkey(key,ctrl,shift,alt,win,allow-modifier-only) => {
                                        return root.captured-hotkey(key,ctrl,shift,alt,win,allow-modifier-only);
                                    }
                                }
                                Hint {text:"单击右侧的按键开始录制，按下组合键后点绿色勾确认；按 Esc 或红色叉放弃本次录制。可以只录一个修饰键（如 Ctrl）、修饰键组合或单个按键，支持字母、数字和 F1–F24。确认后自动保存并立即生效。按住这个按键时，穿透中的贴图临时恢复鼠标交互，松开后立即恢复穿透。它与「恢复贴图」不同：后者按一次切换，不会自动恢复穿透。";}
                            }
                            if root.page-index == 3: VerticalLayout {alignment:start; spacing:8px;
                                SectionTitle {text:"绘制默认值";}
                                HorizontalBox {Text {text:"线宽";font-weight:root.changed-stroke ? 700 : 400;vertical-alignment:center;horizontal-stretch:1;} SpinBox {accessible-label:"线宽";minimum:1;maximum:64;value<=>root.stroke;edited=>{root.mark-changed();}}}
                                HorizontalBox {Text {text:"马赛克块";font-weight:root.changed-block ? 700 : 400;vertical-alignment:center;horizontal-stretch:1;} SpinBox {accessible-label:"马赛克块";minimum:2;maximum:128;value<=>root.block;edited=>{root.mark-changed();}}}
                                HorizontalBox {Text {text:"描边颜色";font-weight:root.changed-stroke-color ? 700 : 400;vertical-alignment:center;horizontal-stretch:1;} LineEdit {accessible-label:"描边颜色";text<=>root.stroke-color-value;edited=>{root.mark-changed();}}}
                                HorizontalBox {Text {text:"填充颜色";font-weight:root.changed-fill-color ? 700 : 400;vertical-alignment:center;horizontal-stretch:1;} LineEdit {accessible-label:"填充颜色";text<=>root.fill-color-value;edited=>{root.mark-changed();}}}
                                HorizontalBox {Text {text:"填充不透明度";font-weight:root.changed-fill-opacity ? 700 : 400;vertical-alignment:center;horizontal-stretch:1;} SpinBox {accessible-label:"填充不透明度";minimum:0;maximum:100;value<=>root.fill-opacity;edited=>{root.mark-changed();}}}
                                HorizontalBox {Text {text:"字号";font-weight:root.changed-font-size ? 700 : 400;vertical-alignment:center;horizontal-stretch:1;} SpinBox {accessible-label:"字号";minimum:12;maximum:200;value<=>root.font-size;edited=>{root.mark-changed();}}}
                                SectionTitle {text:"按工具的颜色";changed:root.changed-paint-tools;}
                                Hint {text:"选择每种工具默认画描边还是填充；文字默认只画填充（字色），可另行打开描边。";}
                                for row in root.paint-tools: HorizontalBox {
                                    Text {text:row.label;vertical-alignment:center;horizontal-stretch:1;}
                                    PaintToggle {label:"描边";on:row.stroke;toggled=>{root.paint-toggled(row.tool, 0, !row.stroke);root.mark-changed();}}
                                    PaintToggle {label:"填充";on:row.fill;toggled=>{root.paint-toggled(row.tool, 1, !row.fill);root.mark-changed();}}
                                }
                                Rule {}
                                SectionTitle {text:"窗口识别";}
                                HorizontalBox {Text {text:"模式";font-weight:root.changed-detect-mode ? 700 : 400;vertical-alignment:center;horizontal-stretch:1;} ComboBox {accessible-label:"窗口识别模式";model:["关闭","光标下的界面元素"];current-index<=>root.detect-mode;selected=>{root.mark-changed();}}}
                                Hint {text:"高亮光标下的界面元素，单击即截取该元素，不必再拖动框选。";}
                                Rule {}
                                SectionTitle {text:"保存位置";changed:root.changed-capture-dir;}
                                HorizontalBox {
                                    LineEdit {accessible-label:"截图文件夹";text<=>root.capture-dir-value;horizontal-stretch:1;placeholder-text:"默认：Snaplight\\captures";edited=>{root.mark-changed();}}
                                    Button {text:"浏览";accessible-label:"选择截图文件夹";clicked=>{root.browse-capture-dir();root.mark-changed();}}
                                }
                                HorizontalBox {
                                    Text {text:"已保存截图";font-weight:600;vertical-alignment:center;horizontal-stretch:1;}
                                    Button {text:"打开文件夹";accessible-label:"打开截图文件夹";clicked=>{root.open-capture-folder();}}
                                }
                                VerticalLayout {alignment:start; spacing:2px;
                                    for capture[index] in root.captures: HorizontalBox {
                                        Text {text:capture.label;vertical-alignment:center;horizontal-stretch:1;overflow:elide;}
                                        Button {text:"打开";accessible-label:"打开截图 " + capture.id;clicked=>{root.open-capture(capture.id);}}
                                        Button {text: root.pending-delete==capture.id ? "确认删除" : "删除";accessible-label:"删除截图 " + capture.id;clicked=>{root.delete-capture(capture.id);}}
                                    }
                                }
                                Text {text: root.captures.length == 0 ? "暂无已保存的截图" : "";}
                            }
                            if root.page-index == 4: VerticalLayout {alignment:start; spacing:8px;
                                SectionTitle {text:"尚未实现";}
                                Hint {text:"翻译计划以插件方式实现：识别选区内的文字（OCR），并把译文返回在截图旁。插件契约与独立宿主已经就绪，但尚未接入 OCR 或翻译引擎，因此这里暂无选项。";}
                            }
                            if root.page-index == 5: VerticalLayout {alignment:start; spacing:8px;
                                SectionTitle {text:"尚未实现";}
                                Hint {text:"屏幕录制计划以插件方式实现：捕获一个区域或整块显示器，带背压地持续编码并输出视频文件。目前只有能力位和进程边界，因此这里暂无选项。";}
                            }
                            if root.page-index == 6: VerticalLayout {alignment:start; spacing:8px;
                                SectionTitle {text:"应用";}
                                HorizontalBox {Text {text:"版本";vertical-alignment:center;horizontal-stretch:1;} Text {text:root.app-version;vertical-alignment:center;color:#4b5563;}}
                                Rule {}
                                SectionTitle {text:"配置文件";}
                                HorizontalBox {
                                    LineEdit {accessible-label:"配置文件路径";text:root.config-path;read-only:true;horizontal-stretch:1;}
                                    Button {text:"打开目录";accessible-label:"打开配置目录";clicked=>{root.open-data-dir();}}
                                }
                                SectionTitle {text:"数据目录";}
                                LineEdit {accessible-label:"数据目录";text:root.data-dir;read-only:true;horizontal-stretch:1;}
                                Hint {text:"配置、窗口状态和已保存的截图都存放在这里，除非用 SNAPLIGHT_DATA_DIR 指向别处。设置修改后会自动保存到 config.json。";}
                            }
                        }
                    }
                }
            }
        }
        Rule {}
        HorizontalBox {padding:12px;spacing:8px;
            Text {text:root.status;vertical-alignment:center;horizontal-stretch:1;overflow:elide;}
            Text {text:"更改自动保存 · 粗体为非默认设置";vertical-alignment:center;color:#6b7280;font-size:11px;overflow:elide;}
        }
    }
}
