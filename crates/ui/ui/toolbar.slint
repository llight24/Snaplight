import { Button, HorizontalBox, VerticalBox, SpinBox, LineEdit, CheckBox, ScrollView } from "std-widgets.slint";
export struct ToolItem { id:int, label:string }
export struct CaptureItem { id:string, label:string }
export component Toolbar inherits Window {
    title: "Snaplight Tools";
    width: 740px;
    height: 176px;
    always-on-top: true;
    in property <[ToolItem]> tools;
    in-out property <color> surface-color: #202124;
    in-out property <color> ink-color: #f4f5f6;
    in-out property <color> accent-color: #36c9a0;
    in-out property <int> stroke: 3;
    in-out property <int> block: 12;
    in-out property <string> text-value: "";
    in-out property <int> active: 0;
    in-out property <int> swatch: 0;
    in-out property <string> status: "";
    background: surface-color;
    callback command(int);
    callback properties-changed(int,int,string,int);
    VerticalBox {
        padding: 8px; spacing: 4px;
        HorizontalBox {
            for tool in root.tools: Button { text: tool.label; checked: root.active==tool.id; clicked=>{root.active=tool.id;root.command(tool.id);} }
            Button {text: "Undo";clicked=>{root.command(10);}}
            Button {text: "Redo";clicked=>{root.command(11);}}
        }
        HorizontalBox {
            Text {text: "Width";color:root.ink-color;vertical-alignment:center;}
            SpinBox {minimum:1;maximum:64;value<=>root.stroke;edited=>{root.properties-changed(root.stroke,root.block,root.text-value,root.swatch);}}
            Text {text: "Mosaic";color:root.ink-color;vertical-alignment:center;}
            SpinBox {minimum:2;maximum:128;value<=>root.block;edited=>{root.properties-changed(root.stroke,root.block,root.text-value,root.swatch);}}
            for color[index] in [#f23340,#35c9a0,#ffc94a,#ffffff]: Rectangle {
                width: 24px; height:24px; background:color; border-width:root.swatch==index ? 2px : 0px;border-color:root.accent-color;
                TouchArea {clicked=>{root.swatch=index;root.properties-changed(root.stroke,root.block,root.text-value,root.swatch);}}
            }
            LineEdit {text<=>root.text-value;placeholder-text:"Text";edited=>{root.properties-changed(root.stroke,root.block,root.text-value,root.swatch);}}
        }
        HorizontalBox {
            Text {text:root.status;color:root.ink-color;overflow:elide;horizontal-stretch:1;vertical-alignment:center;}
            Button {text: "Copy";clicked=>{root.command(12);}}
            Button {text: "Save";clicked=>{root.command(13);}}
            Button {text: "Pin";clicked=>{root.command(14);}}
            Button {text: "Close";clicked=>{root.command(15);}}
        }
    }
}
export component Settings inherits Window {
    title: "Snaplight Settings";
    width: 780px;
    height: 640px;
    in-out property <[ToolItem]> tools;
    in-out property <[CaptureItem]> captures;
    in-out property <string> pending-delete:"";
    in-out property <bool> gpu-pins:false;
    in-out property <int> stroke:3;
    in-out property <int> block:12;
    in-out property <string> background-value:"#202124";
    in-out property <string> foreground-value:"#f4f5f6";
    in-out property <string> accent-value:"#36c9a0";
    in-out property <string> capture-dir-value:"";
    in-out property <string> capture-hotkey-value:"Ctrl+Shift+A";
    in-out property <string> restore-hotkey-value:"Ctrl+Shift+P";
    in-out property <string> status:"";
    callback save();
    callback move-tool(int,int);
    callback browse-capture-dir();
    callback open-capture-folder();
    callback open-capture(string);
    callback delete-capture(string);
    VerticalBox {padding:12px; spacing:6px;
        ScrollView {vertical-stretch:1;
            HorizontalBox {spacing:16px;
                VerticalBox {spacing:4px;
                    Text {text:"Drawing";font-weight:600;}
                    HorizontalBox {Text {text:"Stroke width";vertical-alignment:center;horizontal-stretch:1;} SpinBox {accessible-label:"Stroke width";minimum:1;maximum:64;value<=>root.stroke;}}
                    HorizontalBox {Text {text:"Mosaic block";vertical-alignment:center;horizontal-stretch:1;} SpinBox {accessible-label:"Mosaic block";minimum:2;maximum:128;value<=>root.block;}}
                    Text {text:"Theme";font-weight:600;}
                    HorizontalBox {Text {text:"Background";vertical-alignment:center;horizontal-stretch:1;} LineEdit {accessible-label:"Theme background color";text<=>root.background-value;}}
                    HorizontalBox {Text {text:"Foreground";vertical-alignment:center;horizontal-stretch:1;} LineEdit {accessible-label:"Theme foreground color";text<=>root.foreground-value;}}
                    HorizontalBox {Text {text:"Accent";vertical-alignment:center;horizontal-stretch:1;} LineEdit {accessible-label:"Theme accent color";text<=>root.accent-value;}}
                    CheckBox {text:"GPU pins";checked<=>root.gpu-pins;}
                    Text {text:"Hotkeys";font-weight:600;}
                    HorizontalBox {Text {text:"Capture";vertical-alignment:center;horizontal-stretch:1;} LineEdit {accessible-label:"Capture hotkey";text<=>root.capture-hotkey-value;horizontal-stretch:1;placeholder-text:"Ctrl+Shift+A";}}
                    HorizontalBox {Text {text:"Restore pins";vertical-alignment:center;horizontal-stretch:1;} LineEdit {accessible-label:"Restore pins hotkey";text<=>root.restore-hotkey-value;horizontal-stretch:1;placeholder-text:"Ctrl+Shift+P";}}
                }
                VerticalBox {spacing:4px;horizontal-stretch:1;
                    Text {text:"Tool order";font-weight:600;}
                    for tool[index] in root.tools: HorizontalBox {
                        Text {text:tool.label;vertical-alignment:center;horizontal-stretch:1;}
                        Button {text:"Up";accessible-label:tool.label + " up";clicked=>{root.move-tool(index,-1);}}
                        Button {text:"Down";accessible-label:tool.label + " down";clicked=>{root.move-tool(index,1);}}
                    }
                    Text {text:"Capture folder";font-weight:600;}
                    HorizontalBox {
                        LineEdit {accessible-label:"Capture folder";text<=>root.capture-dir-value;horizontal-stretch:1;placeholder-text:"default: Snaplight\\captures";}
                        Button {text:"Browse";clicked=>{root.browse-capture-dir();}}
                    }
                    HorizontalBox {
                        Text {text:"Saved captures";font-weight:600;vertical-alignment:center;horizontal-stretch:1;}
                        Button {text:"Open folder";clicked=>{root.open-capture-folder();}}
                    }
                    VerticalBox {spacing:2px;
                        for capture[index] in root.captures: HorizontalBox {
                            Text {text:capture.label;vertical-alignment:center;horizontal-stretch:1;overflow:elide;}
                            Button {text:"Open";accessible-label:"Open capture " + capture.id;clicked=>{root.open-capture(capture.id);}}
                            Button {text: root.pending-delete==capture.id ? "Confirm" : "Delete";accessible-label:"Delete capture " + capture.id;clicked=>{root.delete-capture(capture.id);}}
                        }
                    }
                    Text {text: root.captures.length == 0 ? "No saved captures" : "";}
                }
            }
        }
        Text {text:root.status;overflow:elide;}
        Button {text:"Save";clicked=>{root.save();}}
    }
}
